{
  "name": "esc",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=@esc/frontend",
    "dev:backend": "turbo run dev --filter=@esc/backend",
    "dev:indexer": "turbo run dev --filter=@esc/indexer",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "check:fix": "turbo run check:fix",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@esc/configs": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.9.7",
    "typescript": "~5.8.0"
  },
  "pnpm": {
    "overrides": {
      "@walletconnect/logger>pino": "10.0.0"
    }
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  }
}
